[ext_resource type="Texture2D" uid="uid://dsrpvbopm14x5" path="res://party/resource/character/model/texture/majin_blue_body_refmask.png" id="3_p4kmi"]
[ext_resource type="Texture2D" uid="uid://cddxm7gexoi66" path="res://party/resource/character/model/texture/majin_blue_gem_ref.png" id="4_a7vts"]
[ext_resource type="Texture2D" uid="uid://ptu244vlnqe0" path="res://party/resource/character/model/texture/majin_blue_body_spc.png" id="5_6sboy"]
