[ext_resource type="Texture2D" uid="uid://lhlku7dxysvv" path="res://object/player/resource/model/texture/sonic_shoeenvmsk.png" id="3_wabwd"]
[ext_resource type="Texture2D" uid="uid://blnoega1utubp" path="res://object/player/resource/model/texture/sonic_eyeenvmsk.png" id="4_t7tnm"]
