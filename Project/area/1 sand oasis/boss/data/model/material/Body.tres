[sub_resource type="Shader" id="Shader_muqhs"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled;

/* ---- constants (Godot 4 safe) ---- */
const float INV_PI = 1.0 / PI;

uniform vec4 specular_color_multiplier : source_color = vec4(1.0);
global uniform float time;
uniform sampler2D diffuse_texture;
uniform sampler2D specular_texture;
uniform sampler2D normalmap_texture : hint_normal;
uniform sampler2D falloff_texture;
uniform sampler2D environment_texture;
uniform sampler2D environment_mask;
uniform sampler2D emissive_texture;
uniform sampler2D shadow_map;

uniform bool is_double_sided = false;
uniform bool enable_normal_map = true;
uniform bool enable_environment_map = true;
uniform bool use_albedo_as_emissive = false;
uniform bool use_alpha_scissor = false;

uniform vec4 power_gloss_level;
uniform vec4 sonic_skin_falloff_param;
uniform float luminance_range = 1.0;
uniform float alpha_scissor_threshold = 1.0;
uniform float emission_power = 0.0;
uniform float emission_clamp = 1.0;
uniform float normalmap_depth = 2.0;
uniform float damage_flash : hint_range(0.0, 1.0) = 0.0;

uniform vec2 uv_scale = vec2(1.0);
uniform vec2 uv_offset = vec2(0.0);
uniform vec2 uv_speed = vec2(0.0);

uniform float shadow_contrast = 3.0;

varying vec2 specular_uv;
varying vec2 shadow_uv;
varying vec4 vColor;

/* ---- vertex ---- */
void vertex() {
    UV = UV * uv_scale + uv_offset + uv_speed * time;
    specular_uv = UV;
    shadow_uv = UV2;

    /* vertex colors assumed linear */
    vColor = COLOR;
}

/* ---- helpers ---- */
vec3 decode_normal_map(vec4 n) {
    n.xy = n.xy * 2.0 - 1.0;
    n.z = sqrt(max(1.0 - dot(n.xy, n.xy), 0.0));
    return n.xyz;
}

float compute_falloff(float cos_theta) {
    vec4 p = sonic_skin_falloff_param;
    p.z = max(p.z, 0.1);
    return pow(clamp(1.0 - cos_theta, 0.0, 1.0), p.z) * p.y + p.x;
}

float compute_fresnel(float cos_theta) {
    return pow(clamp(1.0 - cos_theta, 0.0, 1.0), 5.0) * 0.7 + 0.3;
}

/* ---- fragment ---- */
void fragment() {
    if (!FRONT_FACING && !is_double_sided) {
        discard;
    }

    /* linear vertex color */
    vec3 vertex_color = vColor.rgb;

    vec4 diffuse = texture(diffuse_texture, UV);
    vec4 shadow = texture(shadow_map, shadow_uv);
    shadow.rgb = pow(shadow.rgb, vec3(shadow_contrast));

    vec4 specular = texture(specular_texture, UV);
    vec3 emissive_sample = pow(texture(emissive_texture, UV).rgb, vec3(2.2));
    float glow_mask = pow(diffuse.g, emission_clamp);

    ALBEDO = vertex_color * diffuse.rgb * diffuse.rgb;
    ALBEDO *= shadow.rgb;

    EMISSION = use_albedo_as_emissive
        ? ALBEDO * glow_mask
        : emissive_sample * glow_mask;

    EMISSION *= emission_power;

    if (enable_normal_map) {
        vec3 n = decode_normal_map(texture(normalmap_texture, UV));
        n.xy *= normalmap_depth;
        n = normalize(n);

        NORMAL = normalize(
            n.x * TANGENT +
            n.y * BINORMAL +
            n.z * NORMAL
        );
    }

    float spec_fresnel = compute_fresnel(dot(NORMAL, VIEW));

    if (enable_environment_map) {
        vec2 env_uv = NORMAL.xy * vec2(0.5, -0.5) + 0.5;
        vec4 env = texture(environment_texture, env_uv);
        vec4 env_mask = texture(environment_mask, UV);

        env.rgb += env.rgb * env.a * luminance_range;
        env.rgb *= specular.a * spec_fresnel;

        EMISSION += env.rgb * env.rgb;
        EMISSION *= env_mask.rgb;
    }

    float gloss = clamp(power_gloss_level.y * 500.0, 1.0, 1024.0);
    float level = power_gloss_level.z * 5.0;

    float cos_theta = pow(clamp(dot(NORMAL, VIEW), 0.0, 1.0), gloss);

    vec4 fake_spec = texture(specular_texture, specular_uv);
    fake_spec.rgb *= cos_theta * level * 0.2 * spec_fresnel;
    fake_spec.rgb *= fake_spec.rgb;
    fake_spec.rgb *= specular_color_multiplier.rgb;

    EMISSION += fake_spec.rgb;

    /* ---- damage flash ---- */
    ALBEDO = mix(ALBEDO, vec3(1.0, 0.0, 0.0), damage_flash * 0.8);
    EMISSION = mix(EMISSION, vec3(0.0), damage_flash * 0.8);

    if (use_alpha_scissor && diffuse.a < alpha_scissor_threshold) {
        discard;
    }
}

/* ---- light ---- */
void light() {
    float cos_theta = dot(LIGHT, NORMAL);
    cos_theta = (cos_theta - 0.05) / (1.0 - 0.05);
    cos_theta = clamp(cos_theta, 0.0, 1.0);
    cos_theta *= cos_theta;

    vec4 shadow_tex = texture(shadow_map, shadow_uv);
    shadow_tex.rgb = pow(shadow_tex.rgb, vec3(shadow_contrast));

    vec4 falloff = texture(falloff_texture, specular_uv);

    vec3 rim_light =
        vColor.rgb *
        falloff.rgb *
        compute_falloff(dot(NORMAL, VIEW));

    rim_light *= rim_light;
    rim_light *= LIGHT_COLOR * INV_PI;

    DIFFUSE_LIGHT +=
        cos_theta * ALBEDO * LIGHT_COLOR * ATTENUATION +
        rim_light * shadow_tex.rgb;

    vec4 spec = texture(specular_texture, specular_uv);
    float fresnel = compute_fresnel(dot(NORMAL, VIEW));
    float gloss = clamp(power_gloss_level.y * 500.0, 1.0, 1024.0);
    float level = power_gloss_level.z * 5.0;

    vec3 half_dir = normalize(LIGHT + VIEW);
    cos_theta = pow(clamp(dot(half_dir, NORMAL), 0.0, 1.0), gloss);

    spec.rgb *= cos_theta * level * fresnel;
    spec.rgb *= spec.rgb;

    vec3 spec_col = spec.rgb * specular_color_multiplier.rgb;

    SPECULAR_LIGHT +=
        spec_col * LIGHT_COLOR * ATTENUATION * 100.0 * shadow_tex.rgb;
}
"

[resource]
render_priority = 0
shader = SubResource("Shader_muqhs")
shader_parameter/specular_color_multiplier = Color(1, 1, 1, 1)
shader_parameter/diffuse_texture = ExtResource("1_lod4n")
shader_parameter/specular_texture = ExtResource("2_okb3k")
shader_parameter/normalmap_texture = ExtResource("2_cj2vn")
shader_parameter/is_double_sided = false
shader_parameter/enable_normal_map = true
shader_parameter/enable_environment_map = false
shader_parameter/use_albedo_as_emissive = false
shader_parameter/use_alpha_scissor = false
shader_parameter/power_gloss_level = Vector4(50, 0.016, 0.038, 0)
shader_parameter/sonic_skin_falloff_param = Vector4(0.1, 0.8, 1, 0)
shader_parameter/luminance_range = 0.0
shader_parameter/alpha_scissor_threshold = 0.5
shader_parameter/emission_power = 0.0
shader_parameter/emission_clamp = 1.0
shader_parameter/normalmap_depth = 1.0
shader_parameter/damage_flash = 0.0
shader_parameter/uv_scale = Vector2(1, 1)
shader_parameter/uv_offset = Vector2(0, 0)
shader_parameter/uv_speed = Vector2(0, 0)
shader_parameter/shadow_contrast = 3.0
