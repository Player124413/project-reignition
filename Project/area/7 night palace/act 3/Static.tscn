[sub_resource type="GDScript" id="GDScript_uffb5"]
script/source = "extends Area3D

@export_range(0.0, 1.0) var wet_target: float = 0.5
@export var fade_time: float = 0.4

# Shared by ALL instances of this script — one reverb effect on one bus.
static var _bus_idx: int = -1
static var _reverb: AudioEffectReverb
static var _tween: Tween
static var _active: Array = []   # zones currently containing the player

func _ready() -> void:
	if _bus_idx == -1:
		_bus_idx = AudioServer.get_bus_index(\"GAME SFX\")
		if _bus_idx == -1:
			push_error(\"Audio bus 'GAME SFX' not found.\")
			return
		_reverb = AudioServer.get_bus_effect(_bus_idx, 0) as AudioEffectReverb
		if _reverb:
			_reverb.wet = 0.0
			AudioServer.set_bus_effect_enabled(_bus_idx, 0, false)
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)

func _exit_tree() -> void:
	_active.erase(self)

func _on_body_entered(body: Node3D) -> void:
	if not body.is_in_group(\"player\"):
		return
	if not _active.has(self):
		_active.append(self)
	_apply()

func _on_body_exited(body: Node3D) -> void:
	if not body.is_in_group(\"player\"):
		return
	_active.erase(self)
	_apply()

func _apply() -> void:
	if _reverb == null:
		return
	var target := 0.0
	if not _active.is_empty():
		target = _active.back().get(\"wet_target\")
	if target > 0.0:
		AudioServer.set_bus_effect_enabled(_bus_idx, 0, true)
	if _tween and _tween.is_valid():
		_tween.kill()
	_tween = create_tween()
	_tween.tween_property(_reverb, \"wet\", target, fade_time)
	if is_zero_approx(target):
		_tween.tween_callback(_disable)

func _disable() -> void:
	AudioServer.set_bus_effect_enabled(_bus_idx, 0, false)
"

