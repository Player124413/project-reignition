[sub_resource type="Shader" id="Shader_cl5sw"]
code = "shader_type canvas_item;
render_mode unshaded, blend_add;

uniform sampler2D depth_tex : filter_linear;
uniform sampler2D screen_texture : hint_screen_texture, filter_linear;
uniform sampler2D light_color : hint_default_white;
uniform vec4 ray_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float ray_length : hint_range(0.0, 1.0) = 1.0;
uniform float ray_intensity : hint_range(0.0, 1.0) = 1.0;
uniform float light_source_scale = 1.0;
uniform float light_source_feather = 2.0;
uniform float noise_strength : hint_range(0.0, 1.0) = 0.2;
uniform vec2 light_source_pos = vec2(0.0, 0.0);
uniform vec3 light_source_dir = vec3(0.5, -1.0, 0.25);
uniform float mask_threshold : hint_range(0.0, 1.0) = 0.5;
uniform float mask_softness : hint_range(0.01, 0.5) = 0.15;
uniform float mask_radius : hint_range(0.01, 0.5) = 0.15;
uniform bool debug_mode = false;
uniform float debug_dot_radius : hint_range(0.001, 0.05) = 0.01;

const int SAMPLE_COUNT = 120;

float random(vec2 uv) {
	return fract(sin(dot(uv.xy, vec2(12.9898, 78.233))) * 43758.5453123);
}

void fragment() {
	vec2 light_pos = light_source_pos;
	vec2 ratio = vec2(SCREEN_PIXEL_SIZE.x / SCREEN_PIXEL_SIZE.y, 1.0);

	if (debug_mode) {
		vec2 diff = (UV - light_pos) / ratio;
		float dist = length(diff);
		float dot_mask = smoothstep(debug_dot_radius, debug_dot_radius * 0.5, dist);
		COLOR.rgb = vec3(dot_mask);
		COLOR.a = 1.0;
	} else {
		vec2 dir = UV - light_pos;
		vec2 dir2 = UV / ratio - light_pos / ratio;
		float light_rays = 0.0;
		vec2 uv2;
		float scale, l;

		for (int i = 0; i < SAMPLE_COUNT; i++) {
			scale = 1.0 - ray_length * (float(i) / float(SAMPLE_COUNT - 1));
			vec2 sample_uv = dir * scale + light_pos;
			l = 1.0 - texture(depth_tex, sample_uv).a;
			uv2 = dir2 * scale * pow(light_source_scale, 2.0);
			l *= smoothstep(1.0, 0.999 - light_source_feather, dot(uv2, uv2) * 4.0);
			light_rays += l / float(SAMPLE_COUNT);
		}

		float n = 1.0 - random(UV) * noise_strength * smoothstep(0.999 - 1.25, 1.0, dot(dir2, dir2) * 2.0);
		light_rays *= n;

		vec3 screen_col = texture(screen_texture, SCREEN_UV).rgb;
		float brightness = max(screen_col.r, max(screen_col.g, screen_col.b));
		float moon_mask = smoothstep(mask_threshold, mask_threshold + mask_softness, brightness);

		float dist_to_light = length((UV - light_pos) / ratio);
		float proximity = 1.0 - smoothstep(0.0, mask_radius, dist_to_light);
		moon_mask *= proximity;

		light_rays *= (1.0 - moon_mask);

		COLOR.rgb = vec3(light_rays * ray_intensity) * texture(light_color, UV).rgb * ray_color.rgb;
		COLOR.a = ray_color.a;
	}
}"

